<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-rule-stats-table" author="arina_baglaeva"> <!-- Замени на свой ник -->
        <createTable tableName="rule_stats">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
                <!-- В PostgreSQL bigserial автоматически создает последовательность -->
            </column>
            <column name="rule_id" type="bigint">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_rule_stats_rule"
                             references="rules(id)"
                             deleteCascade="true"/>
            </column>
            <column name="count" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>